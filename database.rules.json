{
  "rules": {
    ".read": false,
    ".write": false,

    "public": {
      ".read": true,
      ".write": "auth != null && (root.child('admin/roles').child(auth.uid).child('role').val() === 'admin' || root.child('admin/roles').child(auth.uid).child('role').val() === 'editor')"
    },

    "operations": {
      ".read": "auth != null && root.child('admin/roles').child(auth.uid).child('role').exists()",

      "participants": {
        ".write": "auth != null && (root.child('admin/roles').child(auth.uid).child('role').val() === 'admin' || root.child('admin/roles').child(auth.uid).child('role').val() === 'staff')"
      },
      "registrations": {
        ".write": "auth != null && (root.child('admin/roles').child(auth.uid).child('role').val() === 'admin' || root.child('admin/roles').child(auth.uid).child('role').val() === 'staff')"
      },
      "passes": {
        ".write": "auth != null && (root.child('admin/roles').child(auth.uid).child('role').val() === 'admin' || root.child('admin/roles').child(auth.uid).child('role').val() === 'staff')"
      },
      "checkins": {
        ".write": "auth != null && (root.child('admin/roles').child(auth.uid).child('role').val() === 'admin' || root.child('admin/roles').child(auth.uid).child('role').val() === 'staff')"
      },
      "activityCompletions": {
        ".write": "auth != null && (root.child('admin/roles').child(auth.uid).child('role').val() === 'admin' || root.child('admin/roles').child(auth.uid).child('role').val() === 'staff')"
      },
      "prizeClaims": {
        ".write": "auth != null && (root.child('admin/roles').child(auth.uid).child('role').val() === 'admin' || root.child('admin/roles').child(auth.uid).child('role').val() === 'staff')"
      },

      "pointTransactions": {
        ".write": false
      },
      "pointTotals": {
        ".write": false
      },
      "audit": {
        ".write": false
      }
    },

    "admin": {
      ".read": false,
      ".write": false,
      "roles": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admin/roles').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && root.child('admin/roles').child(auth.uid).child('role').val() === 'admin'",
          "role": {
            ".validate": "!newData.exists() || newData.val() === 'admin' || newData.val() === 'editor' || newData.val() === 'staff' || newData.val() === 'viewer'"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
