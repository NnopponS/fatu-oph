# Firebase Web App configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=https://fatu-oph-2026-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vercel Blob is server-side only. Creating a Blob store connected to the
# Vercel project automatically adds this variable to Vercel.
BLOB_READ_WRITE_TOKEN=

# Server-side Realtime Database URL.
FIREBASE_DATABASE_URL=https://fatu-oph-2026-default-rtdb.asia-southeast1.firebasedatabase.app

# Trusted Vercel server operations (points/check-in/redemption/staff creation).
# Create a dedicated Firebase service account for the production project and
# store these only in Vercel/server environments.
FIREBASE_ADMIN_PROJECT_ID=fatu-oph-2026
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Future optional AI provider; the current assistant works without it.
# AI_API_KEY=
