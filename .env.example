# Firebase Web App configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=https://fatu-oph-2026-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Vercel Blob is server-side only. Creating a Blob store connected to the
# Vercel project automatically adds this variable to Vercel.
BLOB_READ_WRITE_TOKEN=

# Optional server aliases. The upload API falls back to the VITE_ values above.
FIREBASE_WEB_API_KEY=
FIREBASE_DATABASE_URL=https://fatu-oph-2026-default-rtdb.asia-southeast1.firebasedatabase.app

# Future server-only secrets must never use a VITE_ prefix.
# AI_API_KEY=
