{
  "name": "fatu-openhouse-2026",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "check": "npm run build && npm run typecheck:api && npm run lint",
    "smoke:api": "npx -y firebase-tools@14.17.0 emulators:exec --only auth,database --project demo-fatu-oph-2026 \"npx tsx scripts/api-smoke.ts\"",
    "mock:generate": "node scripts/mock-demo.mjs generate",
    "mock:seed": "node scripts/mock-demo.mjs seed",
    "mock:clear": "node scripts/mock-demo.mjs clear",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "@vercel/blob": "^2.8.0",
    "animejs": "^4.5.0",
    "firebase": "^12.3.0",
    "firebase-admin": "13.6.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "three": "^0.186.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsqr": "^1.4.0",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.3.1"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
